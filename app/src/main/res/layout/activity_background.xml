<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtBgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bg_title"
        android:textColor="@color/my_custom_color"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="5"
        android:progress="0"
        android:visibility="invisible"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtBgTitle" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtStatus">

        <Button
            android:id="@+id/btnStartHeavy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_heavy" />

        <Button
            android:id="@+id/btnFreezeUi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/freeze_ui" />

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_service" />

        <Button
            android:id="@+id/btnStartLeaky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_leaky" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>